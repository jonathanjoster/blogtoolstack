---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
	title="BlogToolStack — Email Marketing Tools for Bloggers"
	description="Honest comparisons, reviews, and how-to guides on the email marketing and creator tools bloggers actually use to grow their list."
>
	<div class="page-intro">
		<h1>Email marketing tools for bloggers, reviewed honestly</h1>
		<p>Comparisons, reviews, and step-by-step guides to help you pick the right tools to grow and monetize your email list.</p>
	</div>
	<ul class="article-list">
		{articles.map((article) => (
			<li>
				<a href={`/articles/${article.slug}/`}>{article.data.title}</a>
				<p>{article.data.description}</p>
			</li>
		))}
	</ul>
</BaseLayout>
